# ─────────────────────────────────────────────────────────────────────────────
# Random Talks — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   LOCAL:   Copy this file to `.env` and fill in the values below.
#   VERCEL:  Go to Project Settings → Environment Variables → add each key/value.
#   GITHUB:  Go to Settings → Secrets and variables → Actions → add each key.
#
# ⚠️  NEVER commit your actual .env file. It's in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Web App Config ───────────────────────────────────────────────────
# Source: Firebase Console → Project Settings → General → Your Apps → SDK setup
# These are PUBLIC identifiers — safe to expose in browser bundles.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend Token Server ──────────────────────────────────────────────────────
# URL of your deployed Express server (see /server/README.md).
# Leave blank in dev to fall back to the client-side Zego test-token generator.
# In production, set this to your deployed server URL, e.g.:
#   https://your-server.onrender.com
VITE_SERVER_URL=

# ── ZegoCloud (Dev Fallback Only) ─────────────────────────────────────────────
# ⚠️  DEV ONLY — do NOT use these in production.
# These are only used when VITE_SERVER_URL is empty (local development).
# Source: ZegoCloud Console → Projects → Your Project → App ID / Server Secret
VITE_ZEGO_DEV_APP_ID=
VITE_ZEGO_DEV_SERVER_SECRET=
